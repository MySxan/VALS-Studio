{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VALS Studio",
  "version": "0.1.0",
  "identifier": "studio.vals.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VALS Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": false }
}
